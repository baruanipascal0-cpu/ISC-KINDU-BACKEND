APP_NAME="ISC KINDU"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.tld
FRONTEND_PATH=/home/votre-compte/isc-kindu.local

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isc_kindu
DB_USERNAME=isc_kindu_user
DB_PASSWORD=changez-ce-mot-de-passe
# Render PostgreSQL:
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
RUN_MIGRATIONS=true
RUN_SEEDERS=true
MIGRATION_ATTEMPTS=5
MIGRATION_RETRY_SECONDS=5
CORS_ALLOWED_ORIGINS=https://isc-kindu-frontend.baruanipascal0.workers.dev

ADMIN_EMAIL=admin@isc-kindu.test
ADMIN_PASSWORD=changez-ce-mot-de-passe-admin

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.votre-domaine.tld
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@votre-domaine.tld"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
